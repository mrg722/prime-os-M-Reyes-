{"Semana 01":[["SEMANA 1 - REACUMULACION TECNICA CUMPLIDA | VERSIÓN 3 DÍAS",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Objetivo y notas clave: Objetivo: Registrar lo realizado, ordenar el estimulo y usarlo como punto de partida. Fue una buena semana, pero con algunos sets mas intensos de lo ideal en una semana 1. | No se castiga haber apretado: se usa como dato. | Desde Semana 2 buscamos repetir calidad, no sumar ego. | El Dia 3 tuvo buen estimulo, pero el press plano llego cerca de RIR 0/1; la progresion debe controlarse.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Fase","Pecho","Espalda","Cuádriceps","Femoral/glúteo","Deltoides","Brazos","Core/cardio",null,"Semáforo","Verde","Amarillo","Rojo","Regla de progreso","Regla de dolor","Nota"],["Reacumulación técnica","8-10","10-12","8-10","8-10","6-8","4-6","4-6 bloques + cardio opcional",null,"Estado","Plan completo","-5/10% o -1 serie","Pivot del día","Rango alto + RIR = subir","Dolor 5/10 = recortar","No compensar"],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Dia 1 - Upper A registrado",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Ejercicio","Series","Reps objetivo","Peso estimado/real","RIR objetivo","Descanso","Grupo","Tipo","Notas originales","Progresión / criterio",null,null,null,null,null,null],["Press inclinado DB","3","11, 11, 10","35 kg c/u","RIR 2, 2, 1","5 min","Pecho/empuje","Anclaje","Excelente base. Semana 2: mantener o subir solo si se conserva tecnica.","Doble progresión: si completas rango alto con RIR objetivo en 2 exposiciones, sube mínimo disponible. No RIR 0.",null,null,null,null,null,null],["Dominadas lastradas","3","7, 7, 7","+25 kg","RIR 1-2, 1-2, 0-1","3 min","Espalda/escápula","Anclaje","Muy buen anclaje; no repetir RIR 0 todas las semanas.","Doble progresión: si completas rango alto con RIR objetivo en 2 exposiciones, sube mínimo disponible. No RIR 0.",null,null,null,null,null,null],["Press plano barra","2","9, 9","80 kg","RIR 1-2, 1","3 min","Pecho/empuje","Secundario","Estimulo fuerte adicional de pecho.","Mantener técnica; progresar con reps antes que carga.",null,null,null,null,null,null],["Remo frontal polea/maquina","2","10, 10","100 kg","RIR no anotado","2-3 min","Espalda/escápula","Secundario","Mantener pecho estable y sin lumbar.","Mantener técnica; progresar con reps antes que carga.",null,null,null,null,null,null],["Elevaciones laterales","3","22, 22, 22","7.5 kg","Controladas","1 min","Deltoides/escápula","Accesorio","Muy buen volumen de deltoide.","Primero reps y control; subir peso solo si técnica se mantiene. Fallo solo si bajo costo.",null,null,null,null,null,null],["Curl Arnold/concentrado unilateral neutro","1","10 por brazo","15 kg","Controlado","90 s","Deltoides/escápula","Accesorio","Poco volumen directo; se complementa en Dia 3.","Primero reps y control; subir peso solo si técnica se mantiene. Fallo solo si bajo costo.",null,null,null,null,null,null],["Pushdown triceps","2","11, 11","31.5 kg polea","Controlado","2 min","Brazos","Accesorio","Correcto.","Primero reps y control; subir peso solo si técnica se mantiene. Fallo solo si bajo costo.",null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Registro para rellenar - Dia 1 - Upper A registrado",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Ejercicio","Peso real","S1 reps","S1 RIR","S2 reps","S2 RIR","S3 reps","S3 RIR","S4 reps","S4 RIR","Dolor 0-10","Energía 1-10","Estado","Cumplido","Próxima acción","Notas"],["Press inclinado DB",null,null,null,null,null,null,null,null,null,null,null,null,null,"=IF(M19=\"Verde\",\"Subir si cumpliste rango\",IF(M19=\"Amarillo\",\"Mantener o -5/10%\",IF(M19=\"Rojo\",\"Pivot/recortar\",\"\")))",null],["Dominadas lastradas",null,null,nu